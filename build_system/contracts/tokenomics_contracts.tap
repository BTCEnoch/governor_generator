#tokenomics_contracts.tap
# TAP Protocol Smart Contracts for Tokenomics Management
# Enochian Governor Generation System

contract WisdomTokenEconomics {
    # Tokenomics and reward management contract
    
    # Token events
    event WisdomTokensMinted(address indexed recipient, uint256 amount, string reason);
    event QuestlineCompleted(address indexed player, string indexed governor_name, uint256 reward_amount);
    event ArtifactClaimed(address indexed player, string artifact_id, uint256 cost);
    event ReputationUpdated(address indexed player, string indexed governor_name, uint256 new_reputation);
    
    # Token and reward storage
    mapping(address => uint256) public wisdom_token_balances;
    mapping(address => mapping(string => uint256)) public player_governor_reputation;
    mapping(address => string[]) public player_discovered_governors;
    mapping(string => uint256) public artifact_costs;
    mapping(string => bool) public artifact_availability;
    
    # Reward rate configuration
    struct RewardRates {
        uint256 questline_base_reward;
        uint256 storyline_completion_bonus;
        uint256 daily_login_reward;
        uint256 governor_discovery_reward;
        uint256 reputation_tier_multiplier;
    }
    
    # Economic configuration
    RewardRates public reward_rates;
    uint256 public total_wisdom_tokens_issued;
    uint256 public max_token_supply;
    address public economics_admin;
    
    # Player progress tracking
    struct PlayerProgress {
        uint256 total_questlines_completed;
        uint256 total_storylines_completed;
        uint256 governors_discovered;
        uint256 last_login_timestamp;
        uint256 total_wisdom_earned;
        bool is_active;
    }
    
    mapping(address => PlayerProgress) public player_progress;
    
    # Contract initialization
    constructor() {
        economics_admin = msg.sender;
        max_token_supply = 21000000 * 10**18; # 21 million tokens max supply
        
        # Initialize reward rates
        reward_rates = RewardRates({
            questline_base_reward: 100 * 10**18,        # 100 tokens base
            storyline_completion_bonus: 250 * 10**18,   # 250 tokens bonus
            daily_login_reward: 10 * 10**18,            # 10 tokens daily
            governor_discovery_reward: 50 * 10**18,     # 50 tokens per discovery
            reputation_tier_multiplier: 25               # 25% per tier
        });
    }
    
    # Access control
    modifier onlyAdmin() {
        require(msg.sender == economics_admin, "Only economics admin can perform this action");
        _;
    }
    
    # Mint wisdom tokens (admin only)
    function mintWisdomTokens(address _recipient, uint256 _amount, string memory _reason) public onlyAdmin {
        require(_recipient != address(0), "Cannot mint to zero address");
        require(_amount > 0, "Amount must be greater than zero");
        require(total_wisdom_tokens_issued + _amount <= max_token_supply, "Would exceed max token supply");
        
        wisdom_token_balances[_recipient] += _amount;
        total_wisdom_tokens_issued += _amount;
        
        emit WisdomTokensMinted(_recipient, _amount, _reason);
    }
    
    # Record questline completion and distribute rewards
    function completeQuestline(
        address _player,
        string memory _governor_name,
        uint256 _reputation_tier,
        uint256 _node_count
    ) public onlyAdmin {
        require(_player != address(0), "Invalid player address");
        require(_reputation_tier <= 3, "Invalid reputation tier");
        
        # Calculate reward based on questline complexity and reputation tier
        uint256 base_reward = reward_rates.questline_base_reward;
        uint256 tier_bonus = (base_reward * reward_rates.reputation_tier_multiplier * _reputation_tier) / 100;
        uint256 node_bonus = (_node_count * 5 * 10**18); # 5 tokens per node
        uint256 total_reward = base_reward + tier_bonus + node_bonus;
        
        # Update player progress
        player_progress[_player].total_questlines_completed += 1;
        player_progress[_player].total_wisdom_earned += total_reward;
        
        # Update reputation
        player_governor_reputation[_player][_governor_name] += 25; # 25 reputation points
        
        # Mint reward tokens
        if (total_wisdom_tokens_issued + total_reward <= max_token_supply) {
            wisdom_token_balances[_player] += total_reward;
            total_wisdom_tokens_issued += total_reward;
        }
        
        emit QuestlineCompleted(_player, _governor_name, total_reward);
        emit ReputationUpdated(_player, _governor_name, player_governor_reputation[_player][_governor_name]);
    }
    
    # Record storyline completion
    function completeStoryline(
        address _player,
        string memory _governor_name,
        uint256 _reputation_tier
    ) public onlyAdmin {
        require(_player != address(0), "Invalid player address");
        
        uint256 storyline_reward = reward_rates.storyline_completion_bonus;
        uint256 tier_bonus = (storyline_reward * reward_rates.reputation_tier_multiplier * _reputation_tier) / 100;
        uint256 total_reward = storyline_reward + tier_bonus;
        
        # Update player progress
        player_progress[_player].total_storylines_completed += 1;
        player_progress[_player].total_wisdom_earned += total_reward;
        
        # Update reputation significantly for storyline completion
        player_governor_reputation[_player][_governor_name] += 50;
        
        # Mint reward tokens
        if (total_wisdom_tokens_issued + total_reward <= max_token_supply) {
            wisdom_token_balances[_player] += total_reward;
            total_wisdom_tokens_issued += total_reward;
        }
        
        emit ReputationUpdated(_player, _governor_name, player_governor_reputation[_player][_governor_name]);
    }
    
    # Record governor discovery
    function discoverGovernor(address _player, string memory _governor_name) public onlyAdmin {
        require(_player != address(0), "Invalid player address");
        
        # Check if player already discovered this governor
        bool already_discovered = false;
        string[] memory discovered = player_discovered_governors[_player];
        for (uint i = 0; i < discovered.length; i++) {
            if (keccak256(bytes(discovered[i])) == keccak256(bytes(_governor_name))) {
                already_discovered = true;
                break;
            }
        }
        
        if (!already_discovered) {
            player_discovered_governors[_player].push(_governor_name);
            player_progress[_player].governors_discovered += 1;
            
            uint256 discovery_reward = reward_rates.governor_discovery_reward;
            
            # Mint discovery reward
            if (total_wisdom_tokens_issued + discovery_reward <= max_token_supply) {
                wisdom_token_balances[_player] += discovery_reward;
                total_wisdom_tokens_issued += discovery_reward;
                player_progress[_player].total_wisdom_earned += discovery_reward;
            }
        }
    }
    
    # Daily login reward
    function claimDailyReward(address _player) public onlyAdmin {
        require(_player != address(0), "Invalid player address");
        
        PlayerProgress storage progress = player_progress[_player];
        require(block.timestamp >= progress.last_login_timestamp + 24 hours, "Daily reward already claimed");
        
        progress.last_login_timestamp = block.timestamp;
        progress.is_active = true;
        
        uint256 daily_reward = reward_rates.daily_login_reward;
        
        # Mint daily reward
        if (total_wisdom_tokens_issued + daily_reward <= max_token_supply) {
            wisdom_token_balances[_player] += daily_reward;
            total_wisdom_tokens_issued += daily_reward;
            progress.total_wisdom_earned += daily_reward;
        }
    }
    
    # Purchase artifact with wisdom tokens
    function purchaseArtifact(address _player, string memory _artifact_id) public onlyAdmin {
        require(_player != address(0), "Invalid player address");
        require(artifact_availability[_artifact_id], "Artifact not available");
        
        uint256 cost = artifact_costs[_artifact_id];
        require(wisdom_token_balances[_player] >= cost, "Insufficient wisdom tokens");
        
        wisdom_token_balances[_player] -= cost;
        
        emit ArtifactClaimed(_player, _artifact_id, cost);
    }
    
    # Admin functions for artifact management
    function setArtifactCost(string memory _artifact_id, uint256 _cost) public onlyAdmin {
        artifact_costs[_artifact_id] = _cost;
        artifact_availability[_artifact_id] = true;
    }
    
    function toggleArtifactAvailability(string memory _artifact_id) public onlyAdmin {
        artifact_availability[_artifact_id] = !artifact_availability[_artifact_id];
    }
    
    # Update reward rates
    function updateRewardRates(
        uint256 _questline_base,
        uint256 _storyline_bonus,
        uint256 _daily_login,
        uint256 _discovery,
        uint256 _tier_multiplier
    ) public onlyAdmin {
        reward_rates.questline_base_reward = _questline_base;
        reward_rates.storyline_completion_bonus = _storyline_bonus;
        reward_rates.daily_login_reward = _daily_login;
        reward_rates.governor_discovery_reward = _discovery;
        reward_rates.reputation_tier_multiplier = _tier_multiplier;
    }
    
    # View functions
    function getPlayerBalance(address _player) public view returns (uint256) {
        return wisdom_token_balances[_player];
    }
    
    function getPlayerReputation(address _player, string memory _governor_name) public view returns (uint256) {
        return player_governor_reputation[_player][_governor_name];
    }
    
    function getPlayerProgress(address _player) public view returns (PlayerProgress memory) {
        return player_progress[_player];
    }
    
    function getDiscoveredGovernors(address _player) public view returns (string[] memory) {
        return player_discovered_governors[_player];
    }
} 