{
  "pattern_rules": {
    "basic_patterns": {
      "action_patterns": [
        ["action", "influence"],
        ["action", "influence", "domain"],
        ["action", "state", "influence"]
      ],
      "state_patterns": [
        ["state", "influence"],
        ["state", "domain"],
        ["state", "relationship"]
      ],
      "relationship_patterns": [
        ["relationship", "state"],
        ["relationship", "action"],
        ["relationship", "influence"]
      ]
    },
    "advanced_patterns": {
      "chain_patterns": [
        ["action", "influence", "domain", "state"],
        ["relationship", "action", "influence", "domain"],
        ["state", "relationship", "action", "influence"]
      ],
      "cyclic_patterns": [
        ["state", "action", "state"],
        ["influence", "action", "influence"],
        ["domain", "action", "domain"]
      ]
    }
  },
  "combination_rules": {
    "valid_combinations": {
      "heal": {
        "valid_influences": ["body", "mind", "spirit", "energy"],
        "valid_domains": ["physical", "mental", "spiritual"],
        "valid_states": ["diminished", "unbalanced"]
      },
      "protect": {
        "valid_influences": ["body", "mind", "spirit", "space"],
        "valid_domains": ["physical", "mental", "spiritual", "astral"],
        "valid_states": ["active", "enhanced"]
      },
      "transform": {
        "valid_influences": ["matter", "energy", "consciousness"],
        "valid_domains": ["physical", "elemental", "astral"],
        "valid_states": ["active", "balanced"]
      },
      "bind": {
        "valid_influences": ["energy", "space", "time"],
        "valid_domains": ["physical", "astral", "elemental"],
        "valid_states": ["active", "dormant"]
      },
      "reveal": {
        "valid_influences": ["mind", "spirit", "consciousness"],
        "valid_domains": ["mental", "spiritual", "astral"],
        "valid_states": ["enhanced", "active"]
      }
    },
    "forbidden_combinations": [
      ["bind", "spirit", "spiritual"],
      ["conceal", "consciousness", "mental"],
      ["diminish", "energy", "elemental"]
    ]
  },
  "power_levels": {
    "basic": {
      "patterns": [["action", "influence"]],
      "energy_cost": 1,
      "effect_duration": "short"
    },
    "intermediate": {
      "patterns": [["action", "influence", "domain"]],
      "energy_cost": 2,
      "effect_duration": "medium"
    },
    "advanced": {
      "patterns": [["action", "influence", "domain", "state"]],
      "energy_cost": 3,
      "effect_duration": "long"
    },
    "master": {
      "patterns": [["relationship", "action", "influence", "domain", "state"]],
      "energy_cost": 5,
      "effect_duration": "permanent"
    }
  },
  "effect_modifiers": {
    "state_modifiers": {
      "enhanced": 1.5,
      "diminished": 0.5,
      "balanced": 1.0,
      "unbalanced": 0.7
    },
    "relationship_modifiers": {
